{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Fenêtre principale : page locale du launcher. Aucune page distante n'a de capacité.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "allow-get-settings",
    "allow-save-settings",
    "allow-app-info",
    "allow-get-catalog",
    "allow-get-icons",
    "allow-refresh-catalog",
    "allow-toggle-favorite",
    "allow-open-external",
    "allow-get-installs",
    "allow-install-tool",
    "allow-cancel-install",
    "allow-dismiss-install-error",
    "allow-uninstall-tool",
    "allow-launch-tool",
    "allow-get-running",
    "allow-close-tool",
    "allow-get-hotkeys-status",
    "allow-suspend-hotkeys",
    "allow-force-close-tool",
    "allow-get-widgets",
    "allow-open-widget",
    "allow-close-widget",
    "allow-set-widgets-locked",
    "allow-set-widgets-hidden",
    "allow-get-toolbar-prefs",
    "allow-set-tool-in-bar",
    "allow-set-tool-mode",
    "allow-toggle-tool",
    "allow-set-toolbar-open",
    "allow-get-layouts",
    "allow-layout-save",
    "allow-layout-overwrite",
    "allow-layout-rename",
    "allow-layout-move",
    "allow-layout-delete",
    "allow-layout-apply",
    "allow-layout-remove-item",
    "allow-take-layouts-request",
    "allow-get-launcher-update",
    "allow-install-launcher-update"
  ]
}
